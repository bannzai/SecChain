<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Access group shared with the apps. `codesign` does not expand $(AppIdentifierPrefix), so
	     the team identifier is written literally; it must equal
	     SecChainSharedConfig.keychainAccessGroup. No App Sandbox: the tool runs arbitrary commands
	     in arbitrary directories. -->
	<key>keychain-access-groups</key>
	<array>
		<string>TQPN82UBBY.com.bannzai.SecChain.shared</string>
	</array>
	<!-- CloudKit container shared with the apps; it must equal
	     SecChainSharedConfig.cloudKitContainerIdentifier. CloudKit also needs
	     com.apple.application-identifier, which scripts/xcode/embed_cli.sh adds because its value
	     depends on the profile the build embeds. -->
	<key>com.apple.developer.team-identifier</key>
	<string>TQPN82UBBY</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bannzai.SecChain</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
