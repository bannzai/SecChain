<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Info.plist of the embedded command-line tool bundle (Contents/Helpers/secchain.app).
	     The tool is a bundle only so that it can carry embedded.provisionprofile, which authorizes
	     its keychain-access-groups entitlement (documents/PROJECT.md, design decision 2). -->
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIdentifier</key>
	<string>com.bannzai.SecChain.cli</string>
	<key>CFBundleExecutable</key>
	<string>secchain</string>
	<key>CFBundleName</key>
	<string>secchain</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- The tool shows no Dock icon and no menu bar when it presents an authentication prompt. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
