    "page2.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The repository and the command before you approve"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのリポジトリのどのコマンドかを表示"
          }
        }
      }
    },
    "page2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what your AI agent\nwants to run"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI エージェントの実行も\n内容を見てから"
          }
        }
      }
    },
    "page3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never in files, logs, or servers"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルにもログにもサーバーにも残さない"
          }
        }
      }
    },
    "page3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets stay\nin the Keychain"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret は\nKeychain の中だけ"
          }
        }
      }
    },
    "page4.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No .env file\nsecrets arrive as environment variables"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".env を作らず\nコマンドに環境変数として渡す"
          }
        }
      }
    },
    "page4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Mac\njust secchain run"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac では\nsecchain run に渡すだけ"
          }
        }
      }
    },
    "page5.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep agents from reading .env or printing values"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".env の読み取りや値の表示を\nエージェントに許さない"
          }
        }
      }
    },
    "page5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go further with\nClaude Code hooks"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code の hooks で\nさらに守る"
          }
        }
      }
    },
    "page6.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask every time or keep it on this device"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎回の認証も端末から出さない設定も"
