    },
    "page3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never in files, logs, or servers"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルにもログにもサーバーにも残さない"
          }
        }
      }
    },
    "page3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets stay in the Keychain"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret は Keychain の中だけ"
          }
        }
      }
    },
    "page4.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No .env file, secrets arrive as environment variables"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".env を作らず、コマンドに環境変数として渡す"
          }
        }
      }
    },
    "page4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Mac, just secchain run"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac では secchain run に渡すだけ"
          }
        }
      }
    },
    "page5.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep agents from reading .env or printing values"
