    "Save" : {
      "comment" : "Button that saves the secret edited in the sheet",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存"
          }
        }
      }
    },
    "SecChain cannot reach its Keychain items" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SecChain は Keychain の項目にアクセスできません"
          }
        }
      }
    },
    "SecChain cannot see whether iCloud Keychain is on. When it is off, every secret simply stays on this device and keeps working here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SecChain からは iCloud キーチェーンがオンかどうかを確認できません。オフの場合、Secret はすべてこのデバイスにとどまり、ここでそのまま使えます。"
          }
        }
      }
    },
    "SecChain creates a key in the Secure Enclave of this iPhone and publishes only its public key in your private iCloud database. The key itself never leaves this iPhone" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SecChain はこの iPhone の Secure Enclave に鍵を作り、公開鍵だけをあなたのプライベートな iCloud データベースに公開します。鍵そのものはこの iPhone から出ません"
          }
        }
      }
    },
    "SecChain installed from the same developer on every device" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスに同じデベロッパからインストールした SecChain"
          }
        }
      }
    },
    "SecChain stores secrets in the system Keychain and nowhere else" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SecChain は Secret をシステムの Keychain だけに保存し、ほかの場所には保存しません"
          }
        }
      }
    },
    "Secrets" : {
      "comment" : "Label of the names of the secrets the command reads",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret"
          }
        }
      }
    },
    "Secrets marked iCloud Keychain are synchronized by the system, end-to-end encrypted" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud キーチェーンと表示された Secret は、システムがエンドツーエンドで暗号化して同期します"
          }
        }
      }
    },
    "Secrets set to This device only or Device-bound on a Mac stay on that Mac and do not appear here" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac で「このデバイスのみ」または「デバイス固定 (device-bound)」にした Secret はその Mac にとどまり、ここには表示されません"
          }
        }
      }
    },
    "Select a repository" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリを選択"
          }
        }
