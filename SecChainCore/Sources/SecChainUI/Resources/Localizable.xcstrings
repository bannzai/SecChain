            "state" : "translated",
            "value" : "Secret はまだありません"
          }
        }
      }
    },
    "No value is stored for %@ in %@. Store it with 'secchain set %@'." : {
      "comment" : "Error message. The first and the last %@ are the secret name, the second %@ the repository",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
