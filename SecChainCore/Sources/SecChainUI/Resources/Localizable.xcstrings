    },
    "Something went wrong" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題が発生しました"
          }
        }
      }
    },
    "Standard" : {
      "comment" : "Name of a protection level, shown in the protection picker and in each secret's row. The command-line tool calls this level `standard` (secchain set --level standard), so the translated name is followed by that word in parentheses",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準 (standard)"
          }
        }
      }
    },
    "Synchronize with iCloud Keychain" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud キーチェーンと同期"
          }
        }
      }
    },
    "The 'origin' remote (%@) is a local path, which differs between Macs. Give the directory an identifier with '@path <directory> <identifier>' in ~/.secchain." : {
      "comment" : "Error message after a folder was chosen. %@ is the remote URL",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「origin」リモート（%@）はローカルのパスで、Mac ごとに異なります。~/.secchain の「@path <directory> <identifier>」でディレクトリに識別子を付けてください。"
          }
        }
      }
    },
    "The Git repository at %@ has no 'origin' remote, so it cannot be identified on other Macs. Add the remote, or give the directory an identifier with '@path <directory> <identifier>' in ~/.secchain." : {
      "comment" : "Error message after a folder was chosen. %@ is the folder path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Git リポジトリには「origin」リモートがないため、ほかの Mac で識別できません。リモートを追加するか、~/.secchain の「@path <directory> <identifier>」でディレクトリに識別子を付けてください。"
          }
        }
      }
    },
    "The Keychain is not available. Unlock the device or log in and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain を利用できません。デバイスのロックを解除するか、ログインしてもう一度お試しください。"
          }
        }
      }
    },
    "The Keychain itself demands authentication for every read. The secret never leaves this device and is not restored onto a new one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain 自体が読み出しのたびに認証を求めます。Secret はこのデバイスから出ることがなく、新しいデバイスにも復元されません。"
          }
        }
      }
    },
    "The Mac stopped waiting" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac が待機をやめました"
          }
        }
      }
    },
    "The copy is marked as a password so that clipboard managers skip it" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーはパスワードとして扱われ、クリップボードマネージャーの履歴に残りません"
          }
        }
      }
    },
    "The copy stays on this device and is removed from the clipboard after one minute" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーはこのデバイスだけにとどまり、1 分後にクリップボードから消去されます"
          }
        }
      }
    },
    "The name is also the environment variable that secchain run sets" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前は secchain run が設定する環境変数の名前にもなります"
          }
        }
      }
    },
    "The repository is identified by its Git remote, so every checkout of it shares the same secrets" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリは Git リモートで識別されるため、どのチェックアウトでも同じ Secret を共有します"
          }
        }
      }
    },
    "The same Apple Account on every device" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスで同じ Apple アカウント"
          }
        }
      }
    },
    "The secret is synchronized, so it is deleted on all your devices" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Secret は同期されているため、すべてのデバイスから削除されます"
          }
        }
      }
    },
    "The value cannot be recovered" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値は復元できません"
          }
        }
      }
    },
    "The value is empty." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値が空です。"
          }
        }
      }
    },
    "The value is stored in the Keychain only" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値は Keychain だけに保存されます"
          }
        }
      }
    },
    "This binary is not signed with SecChain's Keychain access group, so it cannot reach any secret (errSecMissingEntitlement). Use the secchain tool inside SecChain.app; a binary built with 'swift build' or signed by another team cannot share the app's secrets. Run 'secchain doctor' for details." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバイナリは SecChain の Keychain アクセスグループで署名されていないため、どの Secret にもアクセスできません（errSecMissingEntitlement）。SecChain.app 内の secchain ツールを使ってください。「swift build」でビルドしたバイナリや別のチームが署名したバイナリは、アプリと Secret を共有できません。詳しくは「secchain doctor」を実行してください。"
          }
        }
      }
    },
    "This device only" : {
      "comment" : "Shown in the row of a secret that does not synchronize through iCloud Keychain",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのみ"
          }
        }
      }
    },
    "This device only and device-bound secrets never leave this device" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このデバイスのみ」と「デバイス固定 (device-bound)」の Secret は、このデバイスから出ません"
          }
        }
      }
    },
    "This iPhone" : {
      "comment" : "Section header of the pairing of this device",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone"
          }
        }
      }
    },
    "This key has not reached iCloud yet" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この鍵はまだ iCloud に届いていません"
          }
        }
      }
    },
    "This request has expired" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この依頼は期限切れです"
          }
        }
      }
    },
    "This secret requires authentication, but no prompt can be shown here (for example over SSH). Run the command in a logged-in graphical session." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Secret には認証が必要ですが、ここでは認証のダイアログを表示できません（SSH 経由の場合など）。ログインしているグラフィカルセッションでコマンドを実行してください。"
          }
        }
      }
    },
    "This value is not text and cannot be displayed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この値はテキストではないため表示できません"
          }
        }
      }
    },
    "Time left" : {
      "comment" : "Label of the time the Mac still waits",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り時間"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行"
          }
        }
      }
    },
    "Update %@" : {
      "comment" : "Title of the sheet that replaces the value of the secret %@",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を更新"
          }
        }
      }
    },
    "Update Value" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値を更新"
          }
        }
      }
    },
    "Use letters, digits and underscores, not starting with a digit" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英字、数字、アンダースコアを使い、数字で始めないでください"
          }
        }
      }
    },
    "Value" : {
      "comment" : "Label of the secure text field for the value of a secret",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値"
          }
        }
      }
    },
    "Waiting" : {
      "comment" : "Section header of the requests a Mac is waiting for",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中"
          }
        }
      }
    },
    "What synchronization needs" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期に必要なもの"
          }
        }
      }
    },
    "Your Mac can read the secrets for this command" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコマンドのために Mac が Secret を読み取れます"
          }
        }
      }
    },
    "Your Mac shows the same number while it pairs. Confirm it there only when the two match" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac にもペアリング中に同じ数字が表示されます。両方が一致するときだけ Mac 側で確定してください"
          }
        }
      }
    },
    "Your Mac was told not to read the secrets" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac には Secret を読み取らないよう伝えました"
          }
        }
      }
    },
    "Your Macs can find this key" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの Mac からこの鍵を見つけられます"
          }
        }
      }
    },
    "^[%lld secret](inflect: true)" : {
      "comment" : "Number of secrets of a repository, shown under its name. The ^[…](inflect: true) markup makes English choose secret or secrets; a language without plural forms drops the markup",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件の Secret"
          }
        }
      }
    },
    "approve a request from your Mac" : {
      "comment" : "Reason given to the system authentication prompt before the approval is signed; iOS shows it under the Face ID prompt, so write a short phrase naming the operation, without trailing punctuation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac からの依頼を承認"
          }
        }
      }
    },
    "change the protection of %@" : {
      "comment" : "Reason given to the system authentication prompt; %@ is the secret name. macOS puts it into its own sentence (English: “SecChain is trying to change the protection of NAME.”, Japanese: “SecChainで次の操作を実行しようとしています: …”), so write a short phrase naming the operation, without trailing punctuation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の保護レベルを変更"
          }
        }
      }
    },
    "delete %@" : {
      "comment" : "Reason given to the system authentication prompt; %@ is the secret name. macOS puts it into its own sentence (English: “SecChain is trying to delete NAME.”, Japanese: “SecChainで次の操作を実行しようとしています: …”), so write a short phrase naming the operation, without trailing punctuation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除"
          }
        }
      }
    },
    "git could not be run: %@" : {
      "comment" : "Error message. %@ is the reason given by the system",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git を実行できませんでした：%@"
          }
        }
      }
    },
    "iCloud Keychain" : {
      "comment" : "Shown in the row of a secret that synchronizes through iCloud Keychain",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud キーチェーン"
          }
        }
      }
    },
    "iCloud Keychain turned on in the Apple Account settings of every device" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスの Apple アカウント設定でオンにした iCloud キーチェーン"
          }
        }
      }
    },
    "reveal %@" : {
      "comment" : "Reason given to the system authentication prompt; %@ is the secret name. macOS puts it into its own sentence (English: “SecChain is trying to reveal NAME.”, Japanese: “SecChainで次の操作を実行しようとしています: …”), so write a short phrase naming the operation, without trailing punctuation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の値を表示"
          }
        }
      }
    },
    "secchain run asks for Touch ID or your password every time. The secret can still synchronize." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "secchain run は毎回 Touch ID またはパスワードでの認証を求めます。Secret は同期もできます。"
          }
        }
      }
    },
    "secchain run reads the secret without asking. Revealing the value here still asks for authentication." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "secchain run は認証なしで Secret を読み取ります。ここで値を表示するときは認証が必要です。"
          }
        }
      }
    },
    "update %@" : {
      "comment" : "Reason given to the system authentication prompt; %@ is the secret name. macOS puts it into its own sentence (English: “SecChain is trying to update NAME.”, Japanese: “SecChainで次の操作を実行しようとしています: …”), so write a short phrase naming the operation, without trailing punctuation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を更新"
          }
        }
      }
    },
    "~/.secchain line %lld: '@allow' takes one pattern, a repository identifier or the start of one followed by '*'." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：「@allow」にはパターンを 1 つだけ書きます。リポジトリの識別子か、識別子の先頭に「*」を続けたものです。"
          }
        }
      }
    },
    "~/.secchain line %lld: contains '='. The file lists secret names only; store the value with 'secchain set <NAME> --scope <scope>'." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：「=」が含まれています。このファイルには Secret の名前だけを書きます。値は「secchain set <NAME> --scope <scope>」で保存してください。"
          }
        }
      }
    },
    "~/.secchain line %lld: not a custom scope name. Use lowercase letters, digits and hyphens, starting with a letter or a digit; 'user' and 'repository' are built in." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：カスタム scope の名前ではありません。英小文字、数字、ハイフンを使い、英小文字か数字で始めてください。「user」と「repository」は組み込みの scope です。"
          }
        }
      }
    },
    "~/.secchain line %lld: not a valid secret name. Use letters, digits and underscores, not starting with a digit." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：有効な Secret 名ではありません。英字、数字、アンダースコアを使い、数字で始めないでください。"
          }
        }
      }
    },
    "~/.secchain line %lld: repeats a scope, an '@alias' fork or an '@path' directory of an earlier line." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：前の行と同じ scope、「@alias」の fork、または「@path」のディレクトリが繰り返されています。"
          }
        }
      }
    },
    "~/.secchain line %lld: unknown or incomplete directive. The directives are '@scope <name>', '@allow <pattern>', '@alias <fork> <upstream>' and '@path <absolute directory> <identifier>'." : {
      "comment" : "Error message about the user's definition file ~/.secchain, shown after a folder was chosen. %lld is the line number",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.secchain の %lld 行目：不明または不完全なディレクティブです。使用できるのは「@scope <name>」「@allow <pattern>」「@alias <fork> <upstream>」「@path <absolute directory> <identifier>」です。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
