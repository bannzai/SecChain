{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ already exists in %@." : {
      "comment" : "Error message. The first %@ is the secret name, the second %@ the repository",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %@ にすでに存在します。"
          }
        }
      }
    },
    "%@ is not inside a Git repository. Run secchain inside a repository, or declare an identifier in the secret definition file." : {
      "comment" : "Error message after a folder was chosen. %@ is the folder path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Git リポジトリ内にありません。リポジトリ内で secchain を実行するか、Secret 定義ファイルで識別子を宣言してください。"
          }
        }
      }
    },
    ".secchain line %lld: contains '='. The definition file lists secret names only; store the value with 'secchain set <NAME>'." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：「=」が含まれています。定義ファイルには Secret の名前だけを書きます。値は「secchain set <NAME>」で保存してください。"
          }
        }
      }
    },
    ".secchain line %lld: not a valid secret name. Use letters, digits and underscores, not starting with a digit." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：有効な Secret 名ではありません。英字、数字、アンダースコアを使い、数字で始めないでください。"
          }
        }
      }
    },
    ".secchain line %lld: unknown or incomplete directive. The only directive is '@repository <identifier>'." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：不明または不完全なディレクティブです。使用できるディレクティブは、リポジトリの識別子を宣言する「@repository <identifier>」だけです。"
          }
        }
      }
    },
    "A Git remote URL is accepted too and is normalized the same way secchain does it" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git のリモート URL も入力でき、secchain と同じ方法で正規化されます"
          }
        }
      }
    },
    "A device-bound secret cannot be synchronized. Choose either device-bound or synchronization." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス固定 (device-bound) の Secret は同期できません。デバイス固定と同期のどちらかを選んでください。"
          }
        }
      }
    },
    "About Sync" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期について"
          }
        }
      }
    },
    "Actions for %@" : {
      "comment" : "Accessibility label of the menu button of the secret %@",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の操作"
          }
        }
      }
    },
    "Add" : {
