{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ already exists in %@." : {
      "comment" : "Error message. The first %@ is the secret name, the second %@ the repository",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %@ にすでに存在します。"
          }
        }
      }
    },
    "%@ is not inside a Git repository. Run secchain inside a repository, or give the directory an identifier with '@path <directory> <identifier>' in ~/.secchain." : {
      "comment" : "Error message after a folder was chosen. %@ is the folder path",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Git リポジトリ内にありません。リポジトリ内で secchain を実行するか、~/.secchain の「@path <directory> <identifier>」でディレクトリに識別子を付けてください。"
          }
        }
      }
    },
    ".secchain line %lld: '@repository' is no longer read. Share an upstream's secrets with '@alias <fork> <upstream>', or give a directory without a Git remote an identifier with '@path <directory> <identifier>', in ~/.secchain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：「@repository」は読み込まれなくなりました。上流リポジトリの Secret を共有するには「@alias <fork> <upstream>」を、Git リモートのないディレクトリに識別子を付けるには「@path <directory> <identifier>」を ~/.secchain に書いてください。"
          }
        }
      }
    },
    ".secchain line %lld: contains '='. The definition file lists secret names only; store the value with 'secchain set <NAME>'." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：「=」が含まれています。定義ファイルには Secret の名前だけを書きます。値は「secchain set <NAME>」で保存してください。"
          }
        }
      }
    },
    ".secchain line %lld: not a valid secret name. Use letters, digits and underscores, not starting with a digit." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：有効な Secret 名ではありません。英字、数字、アンダースコアを使い、数字で始めないでください。"
          }
        }
      }
    },
    ".secchain line %lld: unknown directive. The definition file lists secret names only; scopes and identifiers are set in ~/.secchain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".secchain の %lld 行目：不明なディレクティブです。定義ファイルには Secret の名前だけを書きます。scope と識別子は ~/.secchain で設定します。"
          }
        }
      }
    },
    "A Git remote URL is accepted too and is normalized the same way secchain does it" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git のリモート URL も入力でき、secchain と同じ方法で正規化されます"
          }
        }
      }
    },
    "A Mac is asking for your approval" : {
      "comment" : "Body of the notification that a filed approval request sends",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac が承認を求めています"
          }
        }
      }
    },
    "A device-bound secret cannot be synchronized. Choose either device-bound or synchronization." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス固定 (device-bound) の Secret は同期できません。デバイス固定と同期のどちらかを選んでください。"
          }
        }
      }
    },
    "A request from a Mac arrives as a notification. SecChain also looks for waiting requests every time you open it, because a notification can be delayed or dropped" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac からの依頼は通知で届きます。通知は遅れたり届かなかったりするため、SecChain は開くたびに待機中の依頼も確認します"
          }
        }
      }
    },
    "About Sync" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期について"
          }
        }
      }
    },
    "Actions for %@" : {
      "comment" : "Accessibility label of the menu button of the secret %@",
      "localizations" : {
