<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Access group shared with the macOS app and its embedded command-line tool. It must equal
	     SecChainSharedConfig.keychainAccessGroup. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bannzai.SecChain.shared</string>
	</array>
	<!-- CloudKit container that carries remote approval requests between the user's devices
	     (documents/PROJECT.md, "Remote approval"). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bannzai.SecChain</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Lets the app receive the push that the CKQuerySubscription on approval requests sends
	     (documents/PROJECT.md, design decision 5). Development builds use the sandbox environment;
	     the App Store build is re-signed for production by Apple. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
